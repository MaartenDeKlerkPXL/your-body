---
import Base from '../layouts/Base.astro';
import Dial from '../components/Dial.astro';
import Curves from '../components/Curves.astro';
import Journey from '../components/Journey.astro';
import Scrubber from '../components/Scrubber.astro';
import { PHASES } from '../content/phases';

// Server-render the first phase so the page reads fine before (or without) JS.
const first = PHASES[0];
---

<Base
  title="Your Body, Now"
  description="What your body is doing at this very hour, and what you can do with it. An interactive 24-hour journey through your inner clock."
>
  <script is:inline>
    // Decide on the intro before first paint, so nothing flashes. Once per
    // session, never with reduced motion; a failsafe reveals the page if the
    // main script doesn't load.
    (function () {
      try {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (sessionStorage.getItem('ybn-intro')) return;
        sessionStorage.setItem('ybn-intro', '1');
      } catch (e) {
        return;
      }
      var html = document.documentElement;
      html.classList.add('intro');
      setTimeout(function () {
        html.classList.remove('intro');
      }, 6000);
    })();
  </script>

  <canvas class="sky" data-sky aria-hidden="true"></canvas>
  <p class="intro-title" aria-hidden="true" data-intro-title>
    <span class="intro-title__line" data-intro-title-text>
      {
        'Your body keeps time.'.split(' ').map((word, i) => (
          <span class="intro-title__mask">
            <span class="intro-title__word" style={`--i: ${i}`}>
              {word}
            </span>
          </span>
        ))
      }
    </span>
  </p>

  <div class="page">
    <header class="top" data-intro-chrome>
      <a class="brand" href="/" aria-label="Your Body, Now: home">
        <span class="brand__mark" aria-hidden="true"></span>
        Your Body, Now
      </a>

      <div class="status">
        <span class="status__label" data-status>
          <span class="status__dot" aria-hidden="true"></span>
          <span data-status-text>Live</span>
        </span>
        <button class="status__now" type="button" data-now hidden>Back to now</button>
      </div>
    </header>

    <main class="stage">
      <section class="story" aria-labelledby="phase-name">
        <p class="story__lead" data-lead>It’s 00:00. Your body is in</p>
        <h1 class="story__name" id="phase-name" data-phase-name>{first.name}</h1>
        <div class="story__copy" data-phase-copy>
          <p class="story__headline" data-phase-headline>{first.headline}</p>
          <p class="story__body" data-phase-body>{first.body}</p>
          <p class="story__tip">
            <span class="story__tip-label">Try this</span>
            <span data-phase-tip>{first.tip}</span>
          </p>
        </div>
      </section>

      <section class="clock" aria-label="Choose a time">
        <Dial />
        <Scrubber />
        <form class="jump" data-jump data-intro-chrome>
          <label for="jump-time">Jump to</label>
          <input id="jump-time" type="time" step="60" required data-jump-input />
          <button type="submit">Go</button>
        </form>
      </section>
    </main>

    <section class="rhythm" aria-label="Your daily rhythm">
      <Curves />
    </section>

    <Journey />

    <footer class="foot" data-intro-chrome>
      <p>Times are typical for an adult. Your own clock may run earlier or later.</p>
      <a href="/sources/">Method &amp; sources</a>
    </footer>
  </div>

  <button class="sound" type="button" aria-pressed="false" aria-label="Ambient sound" data-sound data-intro-chrome>
    <span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="sound__label" aria-hidden="true">Sound</span>
  </button>

  <p class="visually-hidden" aria-live="polite" data-announce></p>
</Base>

<script>
  import { start } from '../scripts/app';
  start();
</script>

<style>
  /* While the intro is pending, hide what it will reveal. */
  :global(.intro :is([data-intro-chrome], [data-dial], [data-scrub], [data-lead], [data-phase-name], [data-phase-copy], [data-curves])) {
    visibility: hidden;
  }

  .intro-title {
    position: fixed;
    inset: 0;
    z-index: 2;
    margin: 0;
    display: grid;
    place-content: center;
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 4.5vw, 4.5rem);
    font-weight: 300;
    font-stretch: 85%;
    letter-spacing: -0.03em;
    line-height: 1;
    pointer-events: none;
    visibility: hidden;
  }

  /* The opening line animates in with CSS from the very first paint (no
     waiting for JavaScript); intro.ts takes over from there. */
  :global(.intro) .intro-title {
    visibility: visible;
  }

  .intro-title__mask {
    display: inline-block;
    overflow: hidden;
    padding: 0.08em 0.06em 0.14em;
    margin: -0.08em 0.06em -0.14em;
    vertical-align: bottom;
  }

  .intro-title__word {
    display: inline-block;
  }

  /* Not tied to .intro: intro.ts removes that class as soon as it starts. */
  .intro-title__word {
    animation: intro-word 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }

  @keyframes intro-word {
    from {
      transform: translateY(110%);
    }
  }

  /* The same palette as a gradient: shown before the shader is ready, and
     instead of it when WebGL is unavailable. */
  :global(body) {
    background:
      radial-gradient(60% 60% at 72% 45%, var(--glow), transparent 70%) fixed,
      var(--bg);
  }

  .sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .sky:global(.is-ready) {
    opacity: 1;
  }

  .page {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-3) var(--space-5);
    max-width: 1440px;
    margin: 0 auto;
    color: var(--ink);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand__mark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    border-top-color: var(--accent);
    border-right-color: var(--accent);
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .status__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--ink) 8%, transparent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* On small screens, "Back to now" says enough while exploring. */
  @media (max-width: 479px) {
    :global([data-live='false']) .status__label {
      display: none;
    }
  }

  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-muted);
  }

  :global([data-live='true']) .status__dot {
    background: var(--accent);
    animation: pulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px transparent;
    }
  }

  /* --- Sound toggle: fixed bottom-left, above the progress bar on phones -- */
  .sound {
    position: fixed;
    z-index: 4;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border: 1px solid color-mix(in oklab, var(--ink) 20%, transparent);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      bottom var(--duration-layout) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out);
  }

  .sound:hover {
    border-color: color-mix(in oklab, var(--ink) 45%, transparent);
  }

  .sound__bars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 14px;
  }

  .sound__bars i {
    width: 2px;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
    transform: scaleY(0.25);
    transition: transform var(--duration-transition) var(--ease-out);
  }

  .sound[aria-pressed='true'] .sound__bars i {
    animation: sound-bar 1.4s var(--ease-in-out) infinite;
  }

  .sound[aria-pressed='true'] .sound__bars i:nth-child(2) {
    animation-delay: -0.35s;
  }

  .sound[aria-pressed='true'] .sound__bars i:nth-child(3) {
    animation-delay: -0.7s;
  }

  .sound[aria-pressed='true'] .sound__bars i:nth-child(4) {
    animation-delay: -1.05s;
  }

  @keyframes sound-bar {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Without motion the bars simply stand tall when sound is on. */
  @media (prefers-reduced-motion: reduce) {
    .sound[aria-pressed='true'] .sound__bars i {
      animation: none;
      transform: scaleY(0.85);
    }
  }

  /* Phones: an icon button that shares the bottom row with the journey's
     progress bar (which starts just right of it), so it never covers text. */
  @media (max-width: 719px) {
    .sound {
      left: var(--space-3);
      bottom: var(--space-3);
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
    }

    .sound__label {
      display: none;
    }

    /* Keep the end of the page clear of the fixed sound button. */
    .page {
      padding-bottom: calc(var(--space-5) + 56px);
    }
  }

  .status__now,
  .jump button {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg);
    background: var(--ink);
    border: 0;
    border-radius: 999px;
    padding: 8px 16px;
    min-height: 36px;
    white-space: nowrap;
    cursor: pointer;
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .status__now:hover,
  .jump button:hover {
    transform: translateY(-1px);
  }

  .stage {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .story {
    max-width: 40rem;
  }

  .story__lead {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .story__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--display-wght);
    font-stretch: var(--display-wdth);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .story__copy {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
  }

  .story__copy p {
    margin: 0;
  }

  .story__headline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .story__body {
    color: var(--ink-muted);
  }

  .story__tip {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  .story__tip-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .clock {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    /* The rotating arm's square box pokes out diagonally; never let it widen the page. */
    overflow-x: clip;
  }

  /* Phones get the timeline, wider screens the dial. */
  .clock :global([data-scrub]) {
    display: none;
  }

  @media (max-width: 719px) {
    .clock :global([data-dial]) {
      display: none;
    }

    .clock :global([data-scrub]) {
      display: grid;
    }
  }

  .jump {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .jump input {
    font: inherit;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    background: color-mix(in oklab, var(--ink) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--ink) 25%, transparent);
    border-radius: 999px;
    padding: 6px 12px;
    min-height: 36px;
  }

  .jump input::-webkit-calendar-picker-indicator {
    filter: invert(var(--invert, 0));
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .foot p {
    margin: 0;
  }

  @media (min-width: 960px) {
    .page {
      padding: var(--space-5) var(--space-6) var(--space-5);
    }

    .stage {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
</style>
