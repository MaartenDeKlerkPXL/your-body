---
import Base from '../layouts/Base.astro';
---

<Base title="Lost in time · Your Body, Now" description="This page doesn't exist. Head back to the clock.">
  <main class="lost">
    <p class="lost__time" aria-hidden="true">--:--</p>
    <h1>This hour doesn’t exist.</h1>
    <p>The page you were looking for isn’t here, but your body is still keeping time.</p>
    <a class="lost__back" href="/">Back to the clock</a>
  </main>
</Base>

<style>
  :global(body) {
    background:
      radial-gradient(60% 60% at 70% 40%, #272b6e, transparent 70%) fixed,
      #0b1026;
    color: #f2f1fb;
  }

  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }

  .lost__time {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 10vw, 8rem);
    font-weight: 260;
    font-stretch: 80%;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: #8a90ff;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 4vw, 3.5rem);
    font-weight: 560;
    font-stretch: 90%;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  p {
    margin: 0;
    color: #c9c8e0;
  }

  .lost__back {
    justify-self: start;
    margin-top: var(--space-2);
    padding: 12px 22px;
    border-radius: 999px;
    background: #f2f1fb;
    color: #0b1026;
    font-weight: 600;
    text-decoration: none;
  }
</style>
