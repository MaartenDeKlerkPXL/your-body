---
import '@fontsource-variable/instrument-sans/standard.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
// Both faces are used above the fold, so both are preloaded. The display face
// is a subset (see scripts/subset-display-font.sh), declared in global.css.
const displayFont = '/fonts/bricolage-grotesque-display.woff2';
import bodyFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Your Body, Now" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A 24-hour dial over a glowing sky, showing what your body is doing at this hour." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1026" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
