---
import { CURVES, TREND_LABELS, curveTrend, curveValue, describeCurve, levelLabel, sampleCurve, type CurveId } from '../lib/circadian';
import { formatTime } from '../lib/time';

// Drawn once at build time; only the playhead moves at runtime.
const W = 1440;
const H = 100;
const y = (v: number) => H - 6 - v * (H - 14);

const STYLE: Record<CurveId, string> = {
  alertness: 'curve--alertness',
  temperature: 'curve--temperature',
  cortisol: 'curve--cortisol',
  melatonin: 'curve--melatonin',
};

// Text alternatives: a description of every curve's shape (from the model, so
// it always matches the chart) and a table every three hours.
const summary = CURVES.map((c) => describeCurve(c.id)).join(' ');
const rows = Array.from({ length: 8 }, (_, i) => {
  const m = i * 180;
  return {
    m,
    time: formatTime(m),
    // The level is already in words, so a flat stretch reads "steady", not "low, low".
    cells: CURVES.map((c) => {
      const trend = curveTrend(c.id, m);
      return { level: levelLabel(curveValue(c.id, m)), trend: trend === 'low' ? 'steady' : TREND_LABELS[trend] };
    }),
  };
});

const paths = CURVES.map((c) => ({
  ...c,
  className: STYLE[c.id],
  d: sampleCurve(c.id, 10)
    .map(([m, v], i) => `${i ? 'L' : 'M'}${m},${y(v).toFixed(1)}`)
    .join(' '),
}));
---

<figure class="curves" aria-label="Your daily rhythm: four curves over 24 hours" aria-describedby="curves-summary" data-curves>
  <p class="visually-hidden" id="curves-summary">{summary}</p>
  <figcaption class="curves__legend">
    <ul>
      {
        paths.map((p) => (
          <li>
            <svg class="curves__swatch" viewBox="0 0 24 8" aria-hidden="true">
              <line class:list={['curve', p.className]} x1="0" y1="4" x2="24" y2="4" />
            </svg>
            <span>{p.label}</span>
            <span class="curves__trend" data-trend={p.id}>–</span>
          </li>
        ))
      }
    </ul>
    <p class="curves__note">
      Typical rhythm for someone who sleeps around 23:00–07:00. Relative, not measured.
    </p>
  </figcaption>

  <div class="curves__plot">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      {paths.map((p) => <path class:list={['curve', p.className]} d={p.d} vector-effect="non-scaling-stroke" />)}
      <line class="curves__playhead" x1="0" y1="0" x2="0" y2={H} vector-effect="non-scaling-stroke" data-playhead />
    </svg>
    <div class="curves__axis" aria-hidden="true">
      <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
    </div>
  </div>

  <details class="curves__data">
    <summary>Show as table</summary>
    <div class="curves__scroll">
      <table>
        <caption class="visually-hidden">Relative level and direction of each rhythm, every three hours</caption>
        <thead>
          <tr>
            <th scope="col">Time</th>
            {CURVES.map((c) => <th scope="col">{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-curves-row={r.m}>
                <th scope="row">{r.time}</th>
                {r.cells.map((c) => (
                  <td>
                    <span class="curves__level">{c.level}</span>
                    <span class="curves__dir">{c.trend}</span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .curves {
    margin: 0;
    display: grid;
    gap: var(--space-3);
    min-width: 0; /* let the table scroll in its own box instead of widening the page */
  }

  .curves > * {
    min-width: 0;
  }

  .curves__legend ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .curves__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .curves__swatch {
    width: 24px;
    height: 8px;
    overflow: visible;
  }

  .curves__trend {
    color: var(--ink-muted);
  }

  .curves__note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .curves__plot svg {
    display: block;
    width: 100%;
    height: clamp(64px, 10vw, 110px);
    overflow: visible;
  }

  .curve {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* Distinguished by line style as well as weight, never by colour alone. */
  .curve--alertness {
    stroke: var(--accent);
    stroke-width: 3;
  }
  .curve--temperature {
    stroke-dasharray: 8 6;
  }
  .curve--cortisol {
    stroke-opacity: 0.75;
  }
  .curve--melatonin {
    stroke-dasharray: 1 5;
    stroke-width: 2.5;
  }

  .curves__playhead {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.5;
  }

  /* --- Table view ------------------------------------------------------- */
  .curves__data summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .curves__data summary::-webkit-details-marker {
    display: none;
  }

  .curves__data summary::before {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: -45deg;
    transition: rotate var(--duration-micro) var(--ease-out);
  }

  .curves__data[open] summary::before {
    rotate: 45deg;
  }

  /* Wide tables scroll inside their own box, never the page. */
  .curves__scroll {
    overflow-x: auto;
    margin-top: var(--space-2);
  }

  .curves__data table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .curves__data th,
  .curves__data td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in oklab, var(--ink) 15%, transparent);
  }

  .curves__data thead th {
    color: var(--ink-muted);
    font-weight: 600;
  }

  .curves__data tbody th {
    font-weight: 600;
  }

  .curves__level {
    display: block;
  }

  .curves__dir {
    display: block;
    color: var(--ink-muted);
  }

  /* The three hours the clock is showing. */
  .curves__data tr[aria-current='time'] {
    background: color-mix(in oklab, var(--ink) 7%, transparent);
  }

  .curves__axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }
</style>
