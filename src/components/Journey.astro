---
import { PHASES } from '../content/phases';
import { CURVES, TREND_LABELS, curveTrend, curveValue } from '../lib/circadian';
import { formatTime } from '../lib/time';
import { displayAxesStyle } from '../lib/type';
import { SPARK_CONTEXT, SPARK_H, SPARK_W, sparkY } from '../lib/spark';

// Scrolling through this section is travelling through the day: the page's
// clock follows the scroll position (see scripts/journey.ts).
// Mini charts: each chapter shows its three hours with 1.5 h of context on
// either side. Small multiples (one per curve) rather than four colours in one
// plot, so identity is carried by labels, never by colour.
const CONTEXT = SPARK_CONTEXT;

const chapters = PHASES.map((p) => {
  const mid = ((p.start + p.end) / 2) * 60;
  const from = p.start * 60 - CONTEXT;
  const span = (p.end - p.start) * 60 + 2 * CONTEXT;
  const x = (m: number) => ((m - from) / span) * SPARK_W;
  return {
    ...p,
    range: `${formatTime(p.start * 60)}–${p.end === 24 ? '24:00' : formatTime(p.end * 60)}`,
    axes: displayAxesStyle(p),
    from,
    span,
    band: { x: x(p.start * 60), w: x(p.end * 60) - x(p.start * 60) },
    edges: [formatTime(p.start * 60), p.end === 24 ? '24:00' : formatTime(p.end * 60)],
    sparks: CURVES.map((c) => {
      const pts: string[] = [];
      for (let m = from; m <= from + span; m += 5) pts.push(`${x(m).toFixed(1)},${sparkY(curveValue(c.id, m)).toFixed(1)}`);
      const line = `M${pts.join(' L')}`;
      return {
        id: c.id,
        label: c.label,
        trend: TREND_LABELS[curveTrend(c.id, mid)],
        line,
        area: `${line} L${SPARK_W},${SPARK_H} L0,${SPARK_H} Z`,
        start: sparkY(curveValue(c.id, p.start * 60)) / SPARK_H,
      };
    }),
  };
});
---

<section class="journey" aria-labelledby="journey-title" data-journey>
  <div class="journey__intro" data-journey-intro>
    <div class="journey__intro-inner" data-reveal>
      <p class="journey__kicker">Scroll to live a day</p>
      <h2 class="journey__title" id="journey-title">A day in your body</h2>
      <p class="journey__lede">Twenty-four hours, eight phases. Keep scrolling and the clock moves with you.</p>
    </div>
  </div>

  {
    chapters.map((c, i) => (
      <article
        class="chapter"
        id={`phase-${c.id}`}
        aria-labelledby={`chapter-${c.id}`}
        style={c.axes}
        data-chapter
        data-start={c.start}
        data-end={c.end}
      >
        <div class="chapter__inner">
          <header class="chapter__head">
            <p class="chapter__meta">
              <span class="chapter__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="chapter__range">{c.range}</span>
            </p>
            <h3 class="chapter__name" id={`chapter-${c.id}`} tabindex="-1" data-reveal-name>
              {c.name}
            </h3>
          </header>

          <div class="chapter__copy" data-reveal>
            <p class="chapter__headline">{c.headline}</p>
            <p class="chapter__body">{c.body}</p>
            <p class="chapter__tip">
              <span class="chapter__tip-label">Try this</span>
              <span>{c.tip}</span>
            </p>
            <div class="spark" data-spark data-from={c.from} data-span={c.span}>
              <p class="visually-hidden">
                How alertness, core temperature, cortisol and melatonin change from {c.edges[0]} to {c.edges[1]}:
                {c.sparks.map((sp) => `${sp.label} ${sp.trend}.`).join(' ')}
              </p>
              <ul class="spark__list" aria-hidden="true">
                {
                  c.sparks.map((sp) => (
                    <li class="spark__item" data-spark-item={sp.id}>
                      <div class="spark__head">
                        <span class="spark__label">{sp.label}</span>
                        <span class="spark__trend">{sp.trend}</span>
                      </div>
                      <div class="spark__plot">
                        <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none">
                          <rect class="spark__band" x={c.band.x} y="0" width={c.band.w} height={SPARK_H} />
                          <path class="spark__area" d={sp.area} />
                          <path class="spark__line" d={sp.line} vector-effect="non-scaling-stroke" />
                        </svg>
                        <span class="spark__head-line" data-spark-playhead style={`left: ${(c.band.x / SPARK_W) * 100}%`} />
                        <span class="spark__dot" data-spark-dot style={`left: ${(c.band.x / SPARK_W) * 100}%; top: ${sp.start * 100}%`} />
                        <span class="spark__cross" data-spark-cross />
                      </div>
                    </li>
                  ))
                }
              </ul>
              <div class="spark__axis" aria-hidden="true">
                <span style={`left: ${(c.band.x / SPARK_W) * 100}%`}>{c.edges[0]}</span>
                <span style={`left: ${((c.band.x + c.band.w) / SPARK_W) * 100}%`}>{c.edges[1]}</span>
              </div>
              <div class="spark__tip" role="presentation" data-spark-tip hidden></div>
            </div>
            <p class="chapter__refs">
              Sources{' '}
              {c.refs.map((r, j) => (
                <>
                  {j > 0 && ', '}
                  <a href={`/sources/#ref-${r}`} aria-label={`Source ${r}`}>
                    {r}
                  </a>
                </>
              ))}
            </p>
          </div>
        </div>
      </article>
    ))
  }

  <div class="journey__outro" data-journey-outro>
    <div class="journey__outro-inner" data-reveal>
      <p class="journey__kicker">That was a day</p>
      <h2 class="journey__title">Your body runs this loop every 24 hours.</h2>
      <p class="journey__lede">Light, meals, movement and a regular bedtime keep it on time.</p>
      <button class="journey__back" type="button" data-journey-back>Back to now</button>
    </div>
  </div>

  <nav class="hud" aria-label="Jump to a phase of the day" data-hud>
    <span class="hud__time" aria-hidden="true" data-hud-time>00:00</span>
    <div class="hud__rail">
      <span class="hud__fill" data-hud-fill></span>
      <ol class="hud__list">
        {
          chapters.map((c) => (
            <li style={`--at: ${c.start / 24}`}>
              <a class="hud__link" href={`#phase-${c.id}`} data-hud-link={c.id}>
                <span class="hud__dot" aria-hidden="true" />
                <span class="hud__label">{c.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>
</section>

<style>
  .journey {
    position: relative;
  }

  .journey__intro,
  .journey__outro {
    --display-wght: 560;
    --display-wdth: 90%;
    min-height: 130svh;
    display: grid;
    align-items: center;
  }

  .journey__intro-inner,
  .journey__outro-inner {
    position: sticky;
    top: 30svh;
    max-width: 48rem;
  }

  .journey__kicker {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .journey__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1rem + 6vw, 6.5rem);
    font-weight: var(--display-wght);
    font-stretch: var(--display-wdth);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .journey__lede {
    margin: var(--space-4) 0 0;
    max-width: 34rem;
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .journey__back {
    margin-top: var(--space-5);
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--ink);
    border: 0;
    border-radius: 999px;
    padding: 12px 22px;
    min-height: 44px;
    cursor: pointer;
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .journey__back:hover {
    transform: translateY(-1px);
  }

  /* Each chapter is tall; its content stays put while three hours pass. */
  .chapter {
    min-height: 170svh;
  }

  /* The text holds one side; the other side is the stage for the phase's form,
     drawn by the sky shader behind the page. */
  .chapter__inner {
    position: sticky;
    top: 33svh;
    display: grid;
    gap: var(--space-4);
  }

  .chapter__meta {
    margin: 0 0 var(--space-3);
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .chapter__index {
    font-weight: 600;
    color: var(--ink);
  }

  .chapter__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 6vw, 7.5rem);
    font-weight: var(--display-wght);
    font-stretch: var(--display-wdth);
    line-height: 0.9;
    letter-spacing: -0.04em;
    outline: none;
  }

  .chapter__copy {
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
  }

  .chapter__copy p {
    margin: 0;
  }

  .chapter__headline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .chapter__body {
    color: var(--ink-muted);
  }

  .chapter__tip {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }

  .chapter__tip-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  /* --- Mini charts ---------------------------------------------------------- */

  .spark {
    position: relative;
    margin-top: var(--space-2);
  }

  .spark__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .spark__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .spark__label {
    color: var(--ink-muted);
  }

  .spark__trend {
    font-weight: 600;
  }

  .spark__plot {
    position: relative;
    height: 44px;
    cursor: crosshair;
  }

  .spark__plot svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The phase's own three hours; the rest is context. */
  .spark__band {
    fill: var(--ink);
    fill-opacity: 0.045;
  }

  .spark__area {
    fill: var(--ink);
    fill-opacity: 0.05;
  }

  .spark__line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Playhead and dot follow the scroll; positioned in % so the dot stays round. */
  .spark__head-line,
  .spark__cross {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    margin-left: -0.5px;
    background: var(--ink);
    opacity: 0.45;
    pointer-events: none;
  }

  .spark__cross {
    opacity: 0;
    background: var(--ink);
  }

  .spark.is-hover .spark__cross {
    opacity: 0.8;
  }

  .spark__dot {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--bg);
    pointer-events: none;
  }

  .spark__axis {
    position: relative;
    height: 1.25rem;
    margin-top: var(--space-1);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .spark__axis span {
    position: absolute;
    translate: -50% 0;
  }

  /* Same x scale in every chart: the axis sits under the left column. */
  .spark__axis {
    width: calc(50% - var(--space-4) / 2);
  }

  .spark__tip {
    position: absolute;
    z-index: 2;
    min-width: 12.5rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 10px;
    background: var(--bg);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ink) 18%, transparent),
      0 8px 24px color-mix(in oklab, #000 18%, transparent);
    font-size: var(--text-sm);
    pointer-events: none;
    translate: -50% calc(-100% - 10px);
  }

  /* The readout's rows are built at runtime, so they need :global(). */
  .spark__tip :global(strong) {
    display: block;
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-1);
  }

  .spark__tip :global(div) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    white-space: nowrap;
    color: var(--ink-muted);
  }

  .spark__tip :global(b) {
    color: var(--ink);
    font-weight: 600;
  }

  .chapter__refs {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .chapter__refs a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  @media (min-width: 960px) {
    .chapter__inner {
      top: 16svh;
      gap: var(--space-5);
      max-width: min(48%, 44rem);
    }
  }

  /* --- Progress HUD: where in the day you are, and a way to jump ---------- */

  .hud {
    position: fixed;
    z-index: 3;
    right: var(--space-4);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: end;
    gap: var(--space-3);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-layout) var(--ease-out),
      visibility var(--duration-layout);
  }

  :global([data-journey-active='true']) .hud {
    opacity: 1;
    visibility: visible;
  }

  .hud__time {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .hud__rail {
    position: relative;
    width: 2px;
    height: 44svh;
    background: color-mix(in oklab, var(--ink) 18%, transparent);
    border-radius: 2px;
  }

  .hud__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    border-radius: 2px;
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }

  .hud__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hud__list li {
    position: absolute;
    right: 50%;
    top: calc(var(--at) * 100%);
    translate: 50% -50%;
  }

  .hud__link {
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    gap: var(--space-2);
    min-width: 32px;
    min-height: 32px;
    justify-content: center;
    text-decoration: none;
  }

  .hud__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .hud__link[aria-current='true'] .hud__dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.4);
  }

  .hud__label {
    position: absolute;
    right: calc(100% + 4px);
    white-space: nowrap;
    font-size: var(--text-sm);
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity var(--duration-micro) var(--ease-out),
      translate var(--duration-micro) var(--ease-out);
    pointer-events: none;
  }

  .hud__link:hover .hud__label,
  .hud__link:focus-visible .hud__label,
  .hud__link[aria-current='true'] .hud__label {
    opacity: 1;
    translate: 0 0;
  }

  /* Phones: a slim bar along the bottom instead of a side rail. */
  @media (max-width: 719px) {
    .chapter__inner {
      top: 27svh;
      gap: var(--space-3);
    }

    .chapter__copy {
      gap: var(--space-2);
    }

    .spark__list {
      gap: var(--space-2) var(--space-4);
    }

    .spark__plot {
      height: 32px;
    }

    .hud {
      top: auto;
      bottom: var(--space-3);
      left: calc(var(--space-3) + 52px); /* room for the sound button */
      min-height: 44px;
      right: var(--space-3);
      translate: none;
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: stretch;
      padding: var(--space-2) var(--space-3);
      border-radius: 999px;
      background: color-mix(in oklab, var(--bg) 82%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .hud__time {
      font-size: var(--text-base);
    }

    .hud__rail {
      width: auto;
      height: 2px;
    }

    .hud__fill {
      transform-origin: left;
      transform: scaleX(var(--p, 0));
    }

    .hud__list li {
      right: auto;
      top: 50%;
      left: calc(var(--at) * 100%);
      translate: -50% -50%;
    }

    .hud__label {
      display: none;
    }
  }
</style>
