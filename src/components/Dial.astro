---
// A 24-hour dial: 00:00 at the top, clockwise. The arm is rotated by GSAP
// Draggable; everything else on the page follows the arm's angle.
const SIZE = 300;
const C = SIZE / 2;
const R = 128;

const ticks = Array.from({ length: 96 }, (_, i) => {
  const major = i % 4 === 0;
  const angle = (i / 96) * Math.PI * 2;
  const inner = R - (major ? 11 : 5);
  return {
    major,
    x1: C + Math.sin(angle) * inner,
    y1: C - Math.cos(angle) * inner,
    x2: C + Math.sin(angle) * (R - 1),
    y2: C - Math.cos(angle) * (R - 1),
  };
});

const labels = [0, 3, 6, 9, 12, 15, 18, 21].map((h) => {
  const angle = (h / 24) * Math.PI * 2;
  return {
    text: String(h).padStart(2, '0'),
    x: C + Math.sin(angle) * (R - 30),
    y: C - Math.cos(angle) * (R - 30),
  };
});
---

<div class="dial" data-dial>
  <svg class="dial__face" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
    <circle class="dial__track" cx={C} cy={C} r={R} />
    <circle
      class="dial__progress"
      cx={C}
      cy={C}
      r={R}
      pathLength="1440"
      transform={`rotate(-90 ${C} ${C})`}
      data-dial-progress
    />
    {
      ticks.map((t) => (
        <line class:list={['dial__tick', { 'dial__tick--major': t.major }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
      ))
    }
    {
      labels.map((l) => (
        <text class="dial__label" x={l.x} y={l.y}>
          {l.text}
        </text>
      ))
    }
  </svg>

  <div class="dial__arm" data-dial-arm>
    <div
      class="dial__handle"
      role="slider"
      tabindex="0"
      aria-label="Time of day"
      aria-valuemin="0"
      aria-valuemax="1439"
      aria-valuenow="0"
      aria-valuetext="00:00"
      data-dial-handle
    >
      <span class="dial__knob"></span>
    </div>
  </div>

  <div class="dial__center" aria-hidden="true">
    <span class="dial__time" data-dial-time>00:00</span>
    <span class="dial__hint" data-dial-hint>Drag to travel</span>
  </div>
</div>

<style>
  .dial {
    position: relative;
    width: min(78vw, 420px);
    aspect-ratio: 1;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .dial__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    cursor: grab;
  }

  .dial__track {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.14;
    stroke-width: 1.5;
  }

  .dial__progress {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0 1440;
  }

  .dial__tick {
    stroke: var(--ink);
    stroke-opacity: 0.28;
    stroke-width: 1;
  }

  .dial__tick--major {
    stroke-opacity: 0.6;
    stroke-width: 1.5;
  }

  .dial__label {
    fill: var(--ink-muted);
    font-family: var(--font-body);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .dial__arm {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  /* 48px hit area around a 22px knob, sitting on the ring at 12 o'clock. */
  .dial__handle {
    position: absolute;
    left: 50%;
    top: calc((150 - 128) / 300 * 100%);
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    pointer-events: auto;
    cursor: grab;
  }

  .dial__handle:active,
  .dial__face:active {
    cursor: grabbing;
  }

  .dial__knob {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow:
      0 0 0 6px color-mix(in oklab, var(--accent) 35%, transparent),
      0 0 32px 6px color-mix(in oklab, var(--accent) 55%, transparent);
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .dial__handle:hover .dial__knob,
  .dial__handle:focus-visible .dial__knob {
    transform: scale(1.15);
  }

  .dial__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    pointer-events: none;
    gap: var(--space-1);
  }

  .dial__time {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 3.75rem);
    font-weight: 560;
    font-stretch: 90%;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .dial__hint {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
